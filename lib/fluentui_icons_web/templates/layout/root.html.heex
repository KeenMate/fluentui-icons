<!DOCTYPE html>
<html lang="en" class="h-full" data-view-mode="grid">
  <head>
    <meta charset="utf-8"/>
    <script>
      (function() {
        var mode = localStorage.getItem('icon_view_mode') || 'grid';
        document.documentElement.setAttribute('data-view-mode', mode);
      })();
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <!-- SEO Meta Tags -->
    <meta name="description" content="Search 6000+ Microsoft FluentUI System Icons with platform identifiers for iOS, Android, React & Svelte. Filter by style and size, copy code snippets instantly."/>
    <meta name="keywords" content="FluentUI icons, Microsoft icons, icon search, iOS icons, Android icons, React icons, Svelte icons, UI icons, system icons"/>
    <meta name="author" content="KeenMate"/>
    <meta name="robots" content="index, follow"/>
    <link rel="canonical" href="https://fluentui-icons.keenmate.dev"/>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="https://fluentui-icons.keenmate.dev"/>
    <meta property="og:title" content="FluentUI Icon Search - 6000+ Microsoft Icons"/>
    <meta property="og:description" content="Search 6000+ Microsoft FluentUI System Icons with platform identifiers for iOS, Android, React & Svelte. Filter by style and size, copy code snippets instantly."/>
    <meta property="og:site_name" content="FluentUI Icon Search"/>

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:url" content="https://fluentui-icons.keenmate.dev"/>
    <meta name="twitter:title" content="FluentUI Icon Search - 6000+ Microsoft Icons"/>
    <meta name="twitter:description" content="Search 6000+ Microsoft FluentUI System Icons with platform identifiers for iOS, Android, React & Svelte."/>

    <%= csrf_meta_tag() %>
    <.live_title><%= assigns[:page_title] || "FluentUI Icon Search" %></.live_title>
    <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/assets/app.css")}/>
    <script defer phx-track-static type="text/javascript" src={Routes.static_path(@conn, "/assets/app.js")}></script>
    <script defer data-domain="fluentui-icons.keenmate.dev" src="https://stats.keenmate.services/js/plausible.js"></script>
  </head>
  <body class="h-full bg-gray-50 antialiased">
    <%= @inner_content %>
  </body>
</html>
